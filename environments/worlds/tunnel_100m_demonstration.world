    <!-- ── Ground: dark compacted-dirt floor ─────────────────────────────── -->
    <model name='ground_plane'>
      <static>1</static>
      <link name='ground_link'>
        <collision name='ground_collision'>
          <pose>50 0 -0.5 0 0 0</pose>
          <geometry><box><size>400 400 1.0</size></box></geometry>
          <max_contacts>100</max_contacts>
          <surface>
            <contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.8</soft_erp></ode></contact>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <friction><ode><mu>50</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='ground_visual'>
          <pose>50 0 -0.5 0 0 0</pose>
          <geometry><box><size>400 400 1.0</size></box></geometry>
          <material>
            <ambient>0.18 0.16 0.14 1</ambient>
            <diffuse>0.20 0.18 0.15 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Tunnel structure: 2 × 50 m segments = 100 m total ─────────────── -->
    <model name='tunnel_straight_1'>
      <static>1</static>
      <link name='tunnel_straight'>
        <collision name='collision'>
          <geometry><mesh><scale>1 1 1</scale>
            <uri>model://tunnel_straight/meshes/tunnel_straight.dae</uri></mesh></geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp></ode></contact>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <friction><torsional><ode/></torsional><ode><mu>5</mu><mu2>5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry><mesh><scale>1 1 1</scale>
            <uri>model://tunnel_straight/meshes/tunnel_straight.dae</uri></mesh></geometry>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <model name='tunnel_straight_2'>
      <static>1</static>
      <link name='tunnel_straight'>
        <collision name='collision'>
          <geometry><mesh><scale>1 1 1</scale>
            <uri>model://tunnel_straight/meshes/tunnel_straight.dae</uri></mesh></geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp></ode></contact>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <friction><torsional><ode/></torsional><ode><mu>5</mu><mu2>5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry><mesh><scale>1 1 1</scale>
            <uri>model://tunnel_straight/meshes/tunnel_straight.dae</uri></mesh></geometry>
        </visual>
      </link>
      <pose>50 0 0 0 0 0</pose>
    </model>

    <!-- ── End wall: grey stone ───────────────────────────────────────────── -->
    <model name='tunnel_end_wall'>
      <pose>100 0 0 0 0 0</pose>
      <link name='Wall_0'>
        <collision name='Wall_0_Collision'>
          <geometry><box><size>9.15 0.20 8.5</size></box></geometry>
          <pose>0 0 4.25 0 0 0</pose>
          <max_contacts>50</max_contacts>
          <surface>
            <contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp></ode></contact>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <friction><torsional><ode/></torsional><ode><mu>5</mu><mu2>5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='Wall_0_Visual'>
          <pose>0 0 4.25 0 0 0</pose>
          <geometry><box><size>9.15 0.20 8.5</size></box></geometry>
          <material>
            <ambient>0.52 0.50 0.48 1</ambient>
            <diffuse>0.50 0.48 0.46 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 1.5708</pose>
      </link>
      <static>1</static>
    </model>

