        <quadratic>0.015</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
    </light>

    <light name='light_03' type='point'>
      <pose>49 0.0 5.5 0 0 0</pose>
      <diffuse>0.70 0.58 0.38 1</diffuse>
      <specular>0.12 0.10 0.06 1</specular>
      <attenuation>
        <range>20</range>
