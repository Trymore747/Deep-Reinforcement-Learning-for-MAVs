<?xml version="1.0" ?>
<!-- =========================================================================
     tunnel_100m_demonstration.world
     Demonstration environment — realistic mine-tunnel aesthetics
     Base: tunnel_100m_dynamic_20.world (IDENTICAL obstacle layout, 20 total)
     Enhancements:
       - 14 steel arch ribs (every 7 m)
       - Wire-mesh wall panels between ribs
       - 12 rock outcroppings for variable cross-section
       - 7 warm overhead point lights (dim atmospheric lighting)
       - Dark ambient scene (underground feel)
     ========================================================================= -->
<sdf version='1.7'>
  <world name='tunnel_100m_demonstration'>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ── Scene: dark underground atmosphere ─────────────────────────────── -->
    <scene>
      <ambient>0.17 0.15 0.13 1</ambient>
      <background>0.04 0.04 0.05 1</background>
      <shadows>1</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <!-- ── Dim directional fill (very weak — simulates distant sky-scatter) ── -->
    <light name='dim_fill' type='directional'>
      <cast_shadows>0</cast_shadows>
      <pose>50 0 8 0 -0 0</pose>
      <diffuse>0.22 0.20 0.18 1</diffuse>
      <specular>0.03 0.03 0.03 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>0.0 0.05 -1.0</direction>
    </light>


    <light name='light_00' type='point'>
      <pose>7 0.0 5.5 0 0 0</pose>
      <diffuse>0.70 0.58 0.38 1</diffuse>
      <specular>0.12 0.10 0.06 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.35</constant>
        <linear>0.06</linear>
        <quadratic>0.015</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
    </light>

    <light name='light_01' type='point'>
      <pose>21 0.0 5.5 0 0 0</pose>
      <diffuse>0.70 0.58 0.38 1</diffuse>
      <specular>0.12 0.10 0.06 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.35</constant>
        <linear>0.06</linear>
        <quadratic>0.015</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
    </light>

    <light name='light_02' type='point'>
      <pose>35 0.0 5.5 0 0 0</pose>
      <diffuse>0.70 0.58 0.38 1</diffuse>
      <specular>0.12 0.10 0.06 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.35</constant>
