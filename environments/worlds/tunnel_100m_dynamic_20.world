    <!-- ═══════════════════════════════════════════════════════════════════
         ENVIRONMENT: lighting, physics, ground, tunnel structure
         ═══════════════════════════════════════════════════════════════════ -->

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>50 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Firm ground plane -->
    <model name='ground_plane'>
      <static>1</static>
      <link name='ground_link'>
        <collision name='ground_collision'>
          <pose>50 0 -0.5 0 0 0</pose>
          <geometry><box><size>400 400 1.0</size></box></geometry>
          <max_contacts>100</max_contacts>
          <surface>
            <contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.8</soft_erp></ode></contact>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <friction><ode><mu>50</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='ground_visual'>
          <pose>50 0 -0.5 0 0 0</pose>
          <geometry><box><size>400 400 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grass</name></script></material>
        </visual>
      </link>
    </model>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.5 0.5 0.5 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <!-- ═══════════════════════════════════════════════════════════════════
         TUNNEL STRUCTURE: Two 50m segments placed end-to-end = 100m
         tunnel_straight mesh: ~50m long (X), ~8m wide (Y), ~8m tall (Z)
         Segment 1: origin → +50m
         Segment 2: shifted +50m → 100m
         End wall at X ≈ 100
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Tunnel segment 1: X = 0 to 50 -->
    <model name='tunnel_straight_1'>
      <static>1</static>
      <link name='tunnel_straight'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://tunnel_straight/meshes/tunnel_straight.dae</uri>
            </mesh>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp></ode></contact>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <friction><torsional><ode/></torsional><ode><mu>5</mu><mu2>5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://tunnel_straight/meshes/tunnel_straight.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Tunnel segment 2: X = 50 to 100 -->
    <model name='tunnel_straight_2'>
      <static>1</static>
      <link name='tunnel_straight'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://tunnel_straight/meshes/tunnel_straight.dae</uri>
            </mesh>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp></ode></contact>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <friction><torsional><ode/></torsional><ode><mu>5</mu><mu2>5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://tunnel_straight/meshes/tunnel_straight.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <pose>50 0 0 0 0 0</pose>
    </model>

    <!-- End wall at X ≈ 100 -->
    <model name='tunnel_end_wall'>
      <pose>100 0 0 0 0 0</pose>
      <link name='Wall_0'>
        <collision name='Wall_0_Collision'>
          <geometry><box><size>9.15 0.15 8.5</size></box></geometry>
          <pose>0 0 4.25 0 0 0</pose>
          <max_contacts>50</max_contacts>
          <surface>
            <contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp></ode></contact>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <friction><torsional><ode/></torsional><ode><mu>5</mu><mu2>5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='Wall_0_Visual'>
          <pose>0 0 4.25 0 0 0</pose>
          <geometry><box><size>9.15 0.15 8.5</size></box></geometry>
          <material>
            <script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script>
            <ambient>0.76 0.66 0.63 1</ambient>
          </material>
        </visual>
        <pose>0 0 0 0 0 1.5708</pose>
      </link>
      <static>1</static>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         STATIC OBSTACLES — 10 boxes (50% of 20 total obstacles)
         Mix of small (1×1×2) and large (1.8×1×2 or 3×2×3.5) boxes
         Spread every ~5m from X=7 to X=93, various Y offsets
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Box 1: X≈7, small -->
    <model name='sbox_01'>
      <pose>7.0 1.5 0 0 0 0</pose>
      <link name='Wall_0'>
        <collision name='c'><geometry><box><size>1.0 1.0 2.0</size></box></geometry><pose>0 0 1 0 0 0</pose><max_contacts>10</max_contacts>
          <surface><contact><ode/></contact><bounce/><friction><torsional><ode/></torsional><ode/></friction></surface></collision>
        <visual name='v'><pose>0 0 1 0 0 0</pose><geometry><box><size>1.0 1.0 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script><ambient>0.92 0.81 0.62 1</ambient></material></visual>
      </link>
      <static>1</static>
    </model>
    <!-- Box 3: X≈17, large -->
    <model name='lbox_03'>
      <pose>17.0 0.5 0 0 0 0</pose>
      <link name='Wall_0'>
        <collision name='c'><geometry><box><size>1.8 1.0 2.0</size></box></geometry><pose>0 0 1 0 0 0</pose><max_contacts>10</max_contacts>
