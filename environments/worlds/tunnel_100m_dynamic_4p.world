    <!-- ══════════════════════════════════════════════════════════════════
         LIGHTING — maximum brightness tunnel illumination
         Dense lamp grid every 5 m, full-power diffuse, minimal attenuation
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Outdoor sun -->
    <light name='sun' type='directional'>
      <cast_shadows>0</cast_shadows>
      <pose>50 0 50 0 0 0</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.5 0.48 0.40 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.3 0.0 -0.95</direction>
    </light>

    <!-- Strong directional fill shooting down the tunnel from entrance end -->
    <light name='tunnel_fill_fwd' type='directional'>
      <cast_shadows>0</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>1.0 0.95 0.82 1</diffuse>
      <specular>0.50 0.48 0.40 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>1.0 0.0 -0.25</direction>
    </light>

    <!-- Strong directional fill shooting back down from exit end -->
    <light name='tunnel_fill_rev' type='directional'>
      <cast_shadows>0</cast_shadows>
      <pose>100 0 3 0 0 0</pose>
      <diffuse>1.0 0.95 0.82 1</diffuse>
      <specular>0.50 0.48 0.40 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-1.0 0.0 -0.25</direction>
    </light>

    <!-- Overhead fill — straight down, floods floor and tops of obstacles -->
    <light name='tunnel_fill_down' type='directional'>
      <cast_shadows>0</cast_shadows>
      <pose>50 0 10 0 0 0</pose>
      <diffuse>0.90 0.86 0.75 1</diffuse>
