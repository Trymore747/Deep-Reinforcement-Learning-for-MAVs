    <!-- ══════════════════════════════════════════════════════════════════
         SCENE — normal outdoor lighting; tunnel mesh blocks sun inside
         ══════════════════════════════════════════════════════════════════ -->

    <scene>
      <ambient>0.45 0.46 0.44 1</ambient>
      <background>0.18 0.20 0.16 1</background>
      <shadows>0</shadows>
