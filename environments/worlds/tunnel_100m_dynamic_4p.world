<sdf version='1.7'>
  <world name='default'>

    <!-- ═══════════════════════════════════════════════════════════════════
         REALISTIC UNDERGROUND MINING TUNNEL — 100m
         ─────────────────────────────────────────────────────────────────
         • Dark underground atmosphere with dim point-lights (mining lamps)
         • 4 dynamic persons — Stages 2-3: cross-tunnel walkers only
         • 17 static obstacles (68%): mine carts, rock piles, timber beams,
           equipment crates, barrel drums, pipe stacks, rubble
         • Several obstacles placed ALONG the X-axis (centreline) to force
           the DRL agent to learn lateral avoidance
         • First 10 m clear for takeoff / acceleration zone
         • Uses TESTED person model format from tunnel_100m_dynamic_30.world
         ═══════════════════════════════════════════════════════════════════ -->


    <!-- ══════════════════════════════════════════════════════════════════
         DYNAMIC OBSTACLES — 8 walking mine workers
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ── CROSS-TUNNEL WALKERS (Y direction) — workers crossing tunnel ── -->

    <!-- Worker 1: X=12, walks Y=2.5 ↔ -2.5 -->
    <model name="person1_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <inertial><mass>75.0</mass>
          <inertia><ixx>16.75</ixx><ixy>0</ixy><ixz>0</ixz><iyy>16.75</iyy><iyz>0</iyz><izz>1.5</izz></inertia>
        </inertial>
        <collision name="body"><pose>0 0 0.95 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>1.9</length></cylinder></geometry>
          <surface><contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <collision name="bottom"><pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual"><pose>0 0 -0.02 0 0 1.57</pose>
          <geometry><mesh><uri>model://person/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop><velocity>0.5</velocity><angular_velocity>0.8</angular_velocity>
        <path><waypoint>12.0 2.5 0.0</waypoint><waypoint>12.0 -2.5 0.0</waypoint></path>
      </plugin>
    </model>

