<sdf version='1.7'>
  <world name='default'>

    <!-- ═══════════════════════════════════════════════════════════════════
         REAL-WORLD ENVIRONMENT — tunnel_100m_realworld.world
         Uses DARPA SubT Tunnel Tile 5 geometry (5 m wide × 5 m tall × 20 m per tile)
         5 tiles tiled along X-axis → 100 m straight corridor (narrower than training)
         ─────────────────────────────────────────────────────────────────
         Corridor: ±2.5 m lateral (5 m total width, vs 7 m training world)
         Turn point: 95 m   Altitude: 0–5 m
         Dynamic obstacles : 10 walking people (same waypoints as testing world)
         Static obstacles  : 10 mine-realistic objects (debris, crates, barrels)
         Domain gap tested : narrower corridor, different geometry, mine lighting
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─── LIGHTING (dim mine ambient — realistic subterranean) ─── -->
    <light name='overhead_sun' type='directional'>
      <cast_shadows>0</cast_shadows>
      <pose>50 0 10 0 -0 0</pose>
      <diffuse>0.35 0.32 0.28 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>200</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>0 0 -1</direction>
    </light>
    <light name='strip_light_1' type='point'>
      <pose>10 0 4.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>25</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name='strip_light_2' type='point'>
      <pose>30 0 4.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>25</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name='strip_light_3' type='point'>
      <pose>50 0 4.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>25</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name='strip_light_4' type='point'>
      <pose>70 0 4.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>25</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name='strip_light_5' type='point'>
      <pose>90 0 4.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>25</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.25 0.23 0.20 1</ambient>
      <background>0.05 0.05 0.05 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- ═══════════════════════════════════════════════════════════════════
         DYNAMIC OBSTACLES — 10 walking people
         UNCHANGED waypoints from testing world (tunnel_100m_dynamic_20.world)
         Capped at ±2.0 m Y to stay within 5 m corridor
