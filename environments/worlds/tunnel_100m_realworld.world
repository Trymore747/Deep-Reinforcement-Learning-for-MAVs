    <!-- ═══════════════════════════════════════════════════════════════════
         TUNNEL STRUCTURE — 5× Tunnel Tile 5 (DARPA SubT Straight Tile)
         Each tile: 5 m wide × 5 m tall × 20 m long
         Rotated 90° around Z so 20 m length aligns with X (forward) axis
         Tile centers at X=10, 30, 50, 70, 90
         ═══════════════════════════════════════════════════════════════════ -->

    <include>
      <uri>model://tunnel_tile_5</uri>
      <name>tunnel_tile_1</name>
      <pose>10 0 0 0 0 1.5708</pose>
    </include>

    <include>
      <uri>model://tunnel_tile_5</uri>
      <name>tunnel_tile_2</name>
      <pose>30 0 0 0 0 1.5708</pose>
    </include>

    <include>
      <uri>model://tunnel_tile_5</uri>
      <name>tunnel_tile_3</name>
      <pose>50 0 0 0 0 1.5708</pose>
    </include>

    <include>
      <uri>model://tunnel_tile_5</uri>
      <name>tunnel_tile_4</name>
      <pose>70 0 0 0 0 1.5708</pose>
    </include>

    <include>
      <uri>model://tunnel_tile_5</uri>
      <name>tunnel_tile_5</name>
      <pose>90 0 0 0 0 1.5708</pose>
    </include>

    <!-- End wall (blocks X=100 m) -->
    <model name='tunnel_end_wall'>
      <pose>100 0 0 0 0 0</pose>
      <static>true</static>
      <link name='Wall_0'>
        <collision name='Wall_0_Collision'>
          <geometry><box><size>5.5 0.15 5.5</size></box></geometry>
          <pose>0 0 2.75 0 0 0</pose>
        </collision>
        <visual name='Wall_0_Visual'>
          <pose>0 0 2.75 0 0 0</pose>
          <geometry><box><size>5.5 0.15 5.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <pose>0 0 0 0 0 1.5708</pose>
      </link>
    </model>

    <!-- Ground plane (collision only — tile mesh covers visual floor) -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <pose>50 0 -0.01 0 0 0</pose>
          <geometry><box><size>110 6 0.02</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         STATIC OBSTACLES — 10 mine-realistic obstacles
         Mixed: debris piles, equipment crates, barrels, support beams
         All within |Y| ≤ 2.0 m (safe for 5 m wide corridor)
         Distribution mirrors testing world every ~10 m from X=8 to X=93
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- debris_01  X=8,  Y=+1.5   low rubble pile -->
    <model name='debris_01'>
      <pose>8.0 1.5 0 0 0 0</pose>
      <static>true</static>
      <link name='l'>
        <collision name='c'><geometry><box><size>1.2 1.0 0.7</size></box></geometry><pose>0 0 0.35 0 0 0</pose><max_contacts>10</max_contacts></collision>
        <visual name='v'><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.2 1.0 0.7</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Rocky</name></script><ambient>0.45 0.38 0.30 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- crate_03  X=18, Y=-0.8   equipment crate -->
    <model name='crate_03'>
      <pose>18.0 -0.8 0 0 0 0</pose>
      <static>true</static>
      <link name='l'>
        <collision name='c'><geometry><box><size>1.0 1.0 1.5</size></box></geometry><pose>0 0 0.75 0 0 0</pose><max_contacts>10</max_contacts></collision>
        <visual name='v'><pose>0 0 0.75 0 0 0</pose><geometry><box><size>1.0 1.0 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script><ambient>0.55 0.45 0.25 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- barrel_05  X=28, Y=+1.8   oil drum -->
    <model name='barrel_05'>
      <pose>28.0 1.8 0 0 0 0</pose>
      <static>true</static>
      <link name='l'>
